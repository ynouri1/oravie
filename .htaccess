# Rediriger le domaine nu vers www (canonique, en HTTPS) — 301
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^oravie\.tn$ [NC]
    RewriteRule ^ https://www.oravie.tn%{REQUEST_URI} [L,R=301]
</IfModule>

# Interdire l'accès direct au fichier envprod
<Files "envprod">
    Order allow,deny
    Deny from all
</Files>

# Interdire l'accès aux scripts de maintenance/diagnostic (fuite de configuration)
<Files "feedback_diagnostic.php">
    Order allow,deny
    Deny from all
</Files>
<Files "migrate_pricing.php">
    Order allow,deny
    Deny from all
</Files>
<Files "index.php_old">
    Order allow,deny
    Deny from all
</Files>
